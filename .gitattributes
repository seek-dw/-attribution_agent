# 统一换行符：避免 Windows/Linux 协作时整个文件显示为已修改
* text=auto eol=lf

# 明确指定为 LF 的文件类型
*.py    text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# Windows 批处理必须 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制文件不做换行转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.db    binary
*.zip   binary
*.pdf   binary

# 截图默认折叠，避免 PR 里刷屏
*.jpg   linguist-documentation
